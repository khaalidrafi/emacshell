 import android.content.Intent;
@@ -864,6 +865,46 @@ invocation of app_process (through android-emacs) can
     return rows;
   }
 
+  /* Start the activity designated by COMPONENT, a string of the
+     form "PACKAGE/ACTIVITY", with KEYS and VALUES supplied as
+     string intent extras.
+
+     Value is true upon success, false upon failure.  */
+
+  public boolean
+  startActivityByName (String component, String[] keys, String[] values)
+  {
+    ComponentName name;
+    Intent intent;
+    int index, i;
+
+    try
+      {
+	index = component.indexOf ('/');
+
+	if (index <= 0 || index == component.length () - 1)
+	  return false;
+
+	name = new ComponentName (component.substring (0, index),
+				  component.substring (index + 1));
+	intent = new Intent ();
+	intent.setComponent (name);
+	intent.addFlags (Intent.FLAG_ACTIVITY_NEW_TASK);
+
+	if (keys != null)
+	  for (i = 0; i < keys.length; ++i)
+	    intent.putExtra (keys[i], values[i]);
+
+	startActivity (intent);
+      }
+    catch (Exception e)
+      {
+	return false;
+      }
+
+    return true;
+  }
+

+DEFUN ("android-start-activity", Fandroid_start_activity,
+       Sandroid_start_activity, 1, 2, 0,
+       doc: /* Start an Android activity by component name.
+COMPONENT is a string of the form "PACKAGE/ACTIVITY", for example
+"org.gnu.emacs/.EmacsActivity".  EXTRAS, if non-nil, is an
+association list of string keys and string values, each pair
+delivered to the activity as a string intent extra.
+
+Value is t if the activity was started, nil if it could not be
+(such as when the component does not exist or the system refused
+to start it).  Exported activities need no special permission;
+activities that are not exported can only be started by their own
+application.  As with `browse-url', activities are started from
+the Emacs service context with FLAG_ACTIVITY_NEW_TASK set, which
+Android permits while this application is in the foreground.  */)
+  (Lisp_Object component, Lisp_Object extras)
+{
+  jstring component1;
+  jobjectArray keys, values;
+  jmethodID method;
+  jboolean started;
+  ptrdiff_t i, nitems;
+  Lisp_Object tem;
+
+  /* Make sure the Android libraries have been initialized.  */
+
+  if (!android_init_gui)
+    return Qnil;
+
+  CHECK_STRING (component);
+
+  /* Count EXTRAS and verify its shape.  */
+
+  nitems = 0;
+
+  if (!NILP (extras))
+    {
+      tem = extras;
+      FOR_EACH_TAIL (tem)
+	{
+	  CHECK_CONS (XCAR (tem));
+	  CHECK_STRING (XCAR (XCAR (tem)));
+	  CHECK_STRING (XCDR (XCAR (tem)));
+	  nitems++;
+	}
+    }
+
+  /* Encode the component name and the extras.  */
+
+  component1 = android_build_string (component, NULL);
+
+  if (nitems)
+    {
+      keys = (*android_java_env)->NewObjectArray (android_java_env,
+						  nitems,
+						  java_string_class,
+						  NULL);
+      android_exception_check_1 (component1);
+      values = (*android_java_env)->NewObjectArray (android_java_env,
+						    nitems,
+						    java_string_class,
+						    NULL);
+      android_exception_check_2 (component1, keys);
+
+      for (i = 0; i < nitems; ++i)
+	{
+	  Lisp_Object pair, key1, value1;
+
+	  pair = XCAR (extras);
+	  extras = XCDR (extras);
+
+	  key1 = android_build_string (XCAR (pair), component1, keys,
+				       values, NULL);
+	  (*android_java_env)->SetObjectArrayElement (android_java_env,
+						      keys, i, key1);
+	  ANDROID_DELETE_LOCAL_REF (key1);
+
+	  value1 = android_build_string (XCDR (pair), component1, keys,
+					 values, NULL);
+	  (*android_java_env)->SetObjectArrayElement (android_java_env,
+						      values, i, value1);
+	  ANDROID_DELETE_LOCAL_REF (value1);
+	}
+    }
+  else
+    {
+      keys = NULL;
+      values = NULL;
+    }
+
+  /* Start the activity.  */
+
+  method = service_class.start_activity;
+  started = (*android_java_env)->CallNonvirtualBooleanMethod (android_java_env,
+							      emacs_service,
+							      service_class.class,
+							      method,
+							      component1,
+							      keys, values);
+  android_exception_check_3 (component1, keys, values);
+  ANDROID_DELETE_LOCAL_REF (component1);
+  ANDROID_DELETE_LOCAL_REF (keys);
+  ANDROID_DELETE_LOCAL_REF (values);
+
+  return started ? Qt : Qnil;
+}

+  /* Query per-application usage statistics between two times.
+     Return an array of strings, each of the form
+
+       "PACKAGE\tLABEL\tLAST-USED-MS\tFOREGROUND-MS"
+
+     with LABEL empty when no display label could be determined.
+     Packages with no foreground time are NULL elements; value is
+     NULL if the system returned no statistics or this build of
+     Android lacks a UsageStatsManager.
+
+     The android.permission.PACKAGE_USAGE_STATS permission is
+     declared by the manifest, but the user must separately enable
+     "Usage access" for Emacs from the system settings screen.  */
+
+  @SuppressWarnings ("deprecation")
+  public String[]
+  queryUsageStats (long beginTime, long endTime)
+  {
+    UsageStatsManager manager;
+    PackageManager packageManager;
+    List<UsageStats> stats;
+    String[] rows;
+    int i, size;
+
+    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.LOLLIPOP)
+      return null;
+
+    manager
+      = (UsageStatsManager) getSystemService (Context.USAGE_STATS_SERVICE);
+
+    if (manager == null)
+      return null;
+
+    stats = manager.queryUsageStats (UsageStatsManager.INTERVAL_BEST,
+				     beginTime, endTime);
+
+    if (stats == null || (size = stats.size ()) == 0)
+      return null;
+
+    packageManager = getPackageManager ();
+    rows = new String[size];
+
+    for (i = 0; i < size; ++i)
+      {
+	UsageStats stat;
+	ApplicationInfo info;
+	CharSequence label;
+
+	stat = stats.get (i);
+
+	if (stat.getTotalTimeInForeground () <= 0)
+	  {
+	    rows[i] = null;
+	    continue;
+	  }
+
+	try
+	  {
+	    info = packageManager.getApplicationInfo (stat.getPackageName (),
+						      0);
+	    label = packageManager.getApplicationLabel (info);
+	  }
+	catch (Exception e)
+	  {
+	    label = null;
+	  }
+
+	rows[i] = (stat.getPackageName () + "\t"
+		   + (label != null ? label.toString () : "") + "\t"
+		   + stat.getLastTimeUsed () + "\t"
+		   + stat.getTotalTimeInForeground ());
+      }
+
+    return rows;
+  }
+

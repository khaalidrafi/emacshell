+/* Usage Access (UsageStatsManager) support.  */
+
+DEFUN ("android-usage-stats", Fandroid_usage_stats,
+       Sandroid_usage_stats, 2, 2, 0,
+       doc: /* Return per-application usage statistics between two times.
+BEGIN-MS and END-MS are epoch milliseconds delimiting the query
+window, as accepted by UsageStatsManager.queryUsageStats with
+INTERVAL_BEST.  Value is a list of entries, each of the form:
+
+  (PACKAGE LABEL LAST-USED-MS FOREGROUND-MS)
+
+where PACKAGE is the package name, LABEL its display label or nil,
+LAST-USED-MS the last time the package was used and FOREGROUND-MS
+the total time it spent in the foreground, both in epoch
+milliseconds.  Packages with no foreground time are omitted.
+
+Value is nil if this Emacs lacks a display connection, if the system
+returned no statistics for that window, or if "Usage access" has
+not been granted to this application; enable it under Settings,
+"Special app access", "Usage access".  The
+android.permission.PACKAGE_USAGE_STATS permission this facility
+requires is already declared by the Android manifest.
+
+usage: (android-usage-stats BEGIN-MS END-MS) */)
+  (Lisp_Object begin, Lisp_Object end)
+{
+  jobjectArray array;
+  jmethodID method;
+  jsize length, i;
+  intmax_t begin_ms, end_ms;
+  Lisp_Object rows;
+
+  /* Make sure the Android libraries have been initialized.  */
+
+  if (!android_init_gui)
+    return Qnil;
+
+  CHECK_INTEGER (begin);
+  CHECK_INTEGER (end);
+
+  if (!integer_to_intmax (begin, &begin_ms)
+      || !integer_to_intmax (end, &end_ms))
+    error ("BEGIN or END is not representable");
+
+  /* Query the system.  */
+
+  method = service_class.query_usage_stats;
+  array
+    = (*android_java_env)->CallNonvirtualObjectMethod (android_java_env,
+						       emacs_service,
+						       service_class.class,
+						       method,
+						       (jlong) begin_ms,
+						       (jlong) end_ms);
+  android_exception_check ();
+
+  if (!array)
+    return Qnil;
+
+  length = (*android_java_env)->GetArrayLength (android_java_env, array);
+  rows = Qnil;
+
+  for (i = 0; i < length; ++i)
+    {
+      jobject element;
+      const char *utf;
+      const char *tab1, *tab2, *tab3;
+      Lisp_Object package, label, last_used, foreground;
+
+      element = (*android_java_env)->GetObjectArrayElement (android_java_env,
+							    array, i);
+
+      if (!element)
+	continue;
+
+      utf = (*android_java_env)->GetStringUTFChars (android_java_env,
+						    element, NULL);
+
+      if (!utf)
+	{
+	  ANDROID_DELETE_LOCAL_REF (element);
+	  continue;
+	}
+
+      /* Each element is "PACKAGE\tLABEL\tLAST-USED-MS\tFOREGROUND-MS",
+	 with LABEL empty when no display label exists.  */
+
+      tab1 = strchr (utf, '\t');
+      tab2 = tab1 ? strchr (tab1 + 1, '\t') : NULL;
+      tab3 = tab2 ? strchr (tab2 + 1, '\t') : NULL;
+
+      if (tab1 && tab2 && tab3)
+	{
+	  package = build_string (utf, tab1 - utf);
+	  label = (tab2 > tab1 + 1
+		   ? build_string (tab1 + 1, tab2 - tab1 - 1)
+		   : Qnil);
+	  last_used = Fstring_to_number (build_string (tab2 + 1,
+						       tab3 - tab2 - 1),
+					 Qnil);
+	  foreground = Fstring_to_number (build_string (tab3 + 1,
+							strlen (tab3 + 1)),
+					 Qnil);
+	  rows = Fcons (list4 (package, label, last_used, foreground),
+			rows);
+	}
+
+      (*android_java_env)->ReleaseStringUTFChars (android_java_env,
+						  element, utf);
+      ANDROID_DELETE_LOCAL_REF (element);
+    }
+
+  ANDROID_DELETE_LOCAL_REF (array);
+  return Fnreverse (rows);
+}

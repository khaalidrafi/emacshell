+    /**
+     * Emacshell: upstream termux-packages builds dpkg-perl with
+     * Depends: perl, clang, make -- a toolchain not shipped in the
+     * bootstrap -- and dpkg-scanpackages with Depends: dpkg-perl, dpkg.
+     * Bootstraps built before patch 4 recorded both as installed,
+     * breaking `pkg upgrade'.  Purge them once from the Android app
+     * layer when present in var/lib/dpkg/status.
+     */
+    private static void purgePoisonedDpkgSubpackages(final Context context) {
+        try {
+            File statusFile = new File(TERMUX_PREFIX_DIR_PATH, "var/lib/dpkg/status");
+            if (!statusFile.isFile())
+                return;
+
+            boolean dpkgPerlInstalled = false;
+            boolean dpkgScanpackagesInstalled = false;
+            String currentPackage = null;
+            try (BufferedReader reader = new BufferedReader(
+                    new InputStreamReader(new FileInputStream(statusFile), "UTF-8"))) {
+                String line;
+                while ((line = reader.readLine()) != null) {
+                    if (line.trim().isEmpty()) {
+                        currentPackage = null;
+                    } else if (line.startsWith("Package: ")) {
+                        currentPackage = line.substring("Package: ".length()).trim();
+                    } else if (line.startsWith("Status:") && currentPackage != null && !line.contains("not-installed")) {
+                        if ("dpkg-perl".equals(currentPackage)) {
+                            dpkgPerlInstalled = true;
+                        } else if ("dpkg-scanpackages".equals(currentPackage)) {
+                            dpkgScanpackagesInstalled = true;
+                        }
+                    }
+                }
+            }
+            if (!dpkgPerlInstalled && !dpkgScanpackagesInstalled)
+                return;
+
+            File dpkg = new File(TERMUX_PREFIX_DIR_PATH, "bin/dpkg");
+            if (!dpkg.canExecute()) {
+                Logger.logWarn(LOG_TAG, "Cannot purge dpkg-perl/dpkg-scanpackages: " + dpkg + " is not executable");
+                return;
+            }
+
+            List<String> args = new ArrayList<>();
+            args.add("--purge");
+            args.add("--force-depends");
+            args.add("--force-remove-reinstreq");
+            if (dpkgScanpackagesInstalled)
+                args.add("dpkg-scanpackages");
+            if (dpkgPerlInstalled)
+                args.add("dpkg-perl");
+
+            ExecutionCommand cmd = new ExecutionCommand(
+                -1,
+                dpkg.getAbsolutePath(),
+                args.toArray(new String[0]),
+                null,
+                null,
+                true,
+                false);
+            cmd.commandLabel = "Purge dpkg-scanpackages/dpkg-perl";
+            cmd.backgroundCustomLogLevel = Logger.LOG_LEVEL_NORMAL;
+            TermuxTask task = TermuxTask.execute(context, cmd, null, new TermuxShellEnvironmentClient(), true);
+            if (task != null && cmd.isSuccessful() && cmd.resultData.exitCode == 0) {
+                Logger.logInfo(LOG_TAG, "Purged poisoned dpkg-scanpackages/dpkg-perl from existing prefix");
+            } else {
+                Logger.logWarnExtended(LOG_TAG, "dpkg --purge dpkg-scanpackages/dpkg-perl did not succeed: " + cmd.toString());
+            }

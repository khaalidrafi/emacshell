+        <!-- elwidget: Emacs-defined home-screen widgets.  Three sizes
+             share one provider class; each Android widget is bound
+             (bindings.json) to a spec Emacs wrote under
+             ~/.emacs.d/elwidget/specs/ and taps flow back to Emacs via
+             events.jsonl.  APPWIDGET_UPDATE is a protected system
+             broadcast, so the receiver stays non-exported; the tap
+             PendingIntents are self-targeted.  The manifest merger
+             forbids one receiver class three times, so each size is a
+             thin subclass of ElwidgetProvider (all behaviour keyed by
+             widget id, not class). -->
+        <receiver
+            android:name="tech.khalidrafi.emacshell.elwidget.ElwidgetProvider4x1"
+            android:exported="false"
+            android:label="@string/elwidget_name_4x1" >
+            <intent-filter>
+                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
+            </intent-filter>
+            <meta-data
+                android:name="android.appwidget.provider"
+                android:resource="@xml/elwidget_provider_4x1" />
+        </receiver>
+
+        <receiver

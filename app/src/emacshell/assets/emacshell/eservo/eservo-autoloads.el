;;; Generated autoloads from eservo-servo.el

(autoload 'eservo-servo-android-start "eservo-servo" "\
Start the servo Android app on this device, then attach to it.
The on-device answer: Emacs and the servo app share one phone, no
PC, no remote host.  Computes the devtools port (`eservo-servo-port'
when set, else an ephemeral free port), starts
`eservo-servo-android-activity' in `eservo-servo-android-package'
with the intent extra servoargs \"--devtools=PORT\", then attaches
the servo backend on 127.0.0.1:PORT through the ordinary attach
path -- the app's devtools server is simply the local servo.

The app is started through `eservo-servo-android-start-function'.
With \\[universal-argument] (VIA-ADB non-nil) the adb lane is
forced.  Otherwise, when this Emacs lacks `android-start-activity'
and the seam is still the default, the fallback is picked
automatically in this order: the plain `am' lane (termux-am or
/system/bin/am -- zero extra dependencies), then adb (needs
android-tools and wireless-debugging pairing).  A customized seam
is never silently overridden.

(fn &optional VIA-ADB)" t)
(register-definition-prefixes "eservo-servo" '("eservo-servo-"))


